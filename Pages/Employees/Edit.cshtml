@page "{id:int}"
@model MyAppBenchAssignment.Pages.Employees.EditModel
@{
    ViewData["Title"] = "Edit employee";
}

<h1>Edit employee</h1>
<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <partial name="_Form" model="Model.Employee" />
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
