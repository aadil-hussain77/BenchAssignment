@page
@model MyAppBenchAssignment.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Employees</h1>
    <a class="btn btn-primary" asp-page="Create">Add employee</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

@if (Model.Employees.Count == 0)
{
    <p>No employees have been added.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var employee in Model.Employees)
        {
            <tr>
                <td>@employee.EmployeeCode</td>
                <td>@employee.FirstName @employee.LastName</td>
                <td>@employee.Email</td>
                <td>@employee.Department</td>
                <td>@employee.Designation</td>
                <td>@(employee.IsActive ? "Active" : "Inactive")</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@employee.EmployeeId">Edit</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@employee.EmployeeId" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
